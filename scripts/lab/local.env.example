# Names that belong to your machines, kept out of Git (ADR-0009).
# Copy to scripts/lab/local.env (git-ignored) on the workstation and fill in.
# The lab host needs no copy: Jenkins runs the verify scripts there with MINI=local.

# The workstation's standard account that runs Jenkins (scripts/jenkins/air-setup.sh).
SV_JENKINS_USER=REPLACE_ME
# The lab host's hostname, exactly as it appears in your ~/.ssh/known_hosts.
SV_LAB_HOST=REPLACE_ME
# Your SSH aliases for the lab host: the lab account (bot) and the admin account.
SV_LAB_SSH=lab
SV_LAB_ADMIN_SSH=lab-admin
