# Placeholders only. The real file, secrets.auto.tfvars, is git-ignored and written on the Mac mini
# by scripts/secrets/new-secrets-tfvars.sh, which asks for the Stripe keys and generates the rest.

environments = {
  dev = {
    stripe_secret_key      = "sk_test_REPLACE_ME"
    stripe_publishable_key = "pk_test_REPLACE_ME"
    stripe_webhook_secret  = "whsec_REPLACE_ME"
    db_passwords = {
      listings      = "REPLACE_WITH_20_OR_MORE_CHARACTERS"
      orders        = "REPLACE_WITH_20_OR_MORE_CHARACTERS"
      payments      = "REPLACE_WITH_20_OR_MORE_CHARACTERS"
      notifications = "REPLACE_WITH_20_OR_MORE_CHARACTERS"
    }
  }
  prod = {
    stripe_secret_key      = "sk_test_REPLACE_ME"
    stripe_publishable_key = "pk_test_REPLACE_ME"
    stripe_webhook_secret  = "whsec_REPLACE_ME"
    db_passwords = {
      listings      = "REPLACE_WITH_20_OR_MORE_CHARACTERS"
      orders        = "REPLACE_WITH_20_OR_MORE_CHARACTERS"
      payments      = "REPLACE_WITH_20_OR_MORE_CHARACTERS"
      notifications = "REPLACE_WITH_20_OR_MORE_CHARACTERS"
    }
  }
}

tls_certificate = <<-EOT
  -----BEGIN CERTIFICATE-----
  REPLACE_ME
  -----END CERTIFICATE-----
EOT

tls_private_key = <<-EOT
  REPLACE_ME (mkcert private key, PEM)
EOT
