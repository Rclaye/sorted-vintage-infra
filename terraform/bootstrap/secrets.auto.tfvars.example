# Placeholders only. The real file, secrets.auto.tfvars, is git-ignored and written on the lab host
# by scripts/secrets/new-secrets-tfvars.sh, which asks for the Stripe keys and generates the rest.

environments = {
  dev = {
    stripe_secret_key      = "sk_test_REPLACE_ME"
    stripe_publishable_key = "pk_test_REPLACE_ME"
    stripe_webhook_secret  = "whsec_REPLACE_ME"
    db_passwords = {
      listings      = "REPLACE_WITH_20_OR_MORE_CHARACTERS"
      orders        = "REPLACE_WITH_20_OR_MORE_CHARACTERS"
      payments      = "REPLACE_WITH_20_OR_MORE_CHARACTERS"
      notifications = "REPLACE_WITH_20_OR_MORE_CHARACTERS"
    }
  }
  prod = {
    stripe_secret_key      = "sk_test_REPLACE_ME"
    stripe_publishable_key = "pk_test_REPLACE_ME"
    stripe_webhook_secret  = "whsec_REPLACE_ME"
    db_passwords = {
      listings      = "REPLACE_WITH_20_OR_MORE_CHARACTERS"
      orders        = "REPLACE_WITH_20_OR_MORE_CHARACTERS"
      payments      = "REPLACE_WITH_20_OR_MORE_CHARACTERS"
      notifications = "REPLACE_WITH_20_OR_MORE_CHARACTERS"
    }
  }
}

# Garage formats: rpc_secret and *_secret_key are 64 hex characters, admin_token is 32+ characters,
# *_key_id is GK followed by 24 hex characters. scripts/secrets/add-garage-secrets.sh generates them.
garage = {
  dev = {
    rpc_secret         = "REPLACE_ME"
    admin_token        = "REPLACE_ME"
    photos_key_id      = "GKREPLACE_ME"
    photos_secret_key  = "REPLACE_ME"
    backups_key_id     = "GKREPLACE_ME"
    backups_secret_key = "REPLACE_ME"
  }
  prod = {
    rpc_secret         = "REPLACE_ME"
    admin_token        = "REPLACE_ME"
    photos_key_id      = "GKREPLACE_ME"
    photos_secret_key  = "REPLACE_ME"
    backups_key_id     = "GKREPLACE_ME"
    backups_secret_key = "REPLACE_ME"
  }
}

# Keycloak: passwords and client secrets of 32+ characters. scripts/secrets/add-keycloak-secrets.sh generates them.
keycloak = {
  admin_password = "REPLACE_ME"
  db_password    = "REPLACE_ME"
  clients = {
    dev  = { bff = "REPLACE_ME", orders = "REPLACE_ME", payments = "REPLACE_ME", listings = "REPLACE_ME" }
    prod = { bff = "REPLACE_ME", orders = "REPLACE_ME", payments = "REPLACE_ME", listings = "REPLACE_ME" }
  }
}

# sv-dev seed job (T051): each demo seller's key (its email is <key>@sortedvtg.lan) and the Stripe
# test account onboarded once by hand for it in the dev sandbox. verify-seller is the user that
# verify_sprint2.sh signs in as. Leave the map empty until the accounts exist.
seed_sellers = {
  "demo-seller-1" = "acct_REPLACE_ME"
  "demo-seller-2" = "acct_REPLACE_ME"
  "verify-seller" = "acct_REPLACE_ME"
}

tls_certificate = <<-EOT
  -----BEGIN CERTIFICATE-----
  REPLACE_ME
  -----END CERTIFICATE-----
EOT

tls_private_key = <<-EOT
  REPLACE_ME (mkcert private key, PEM)
EOT
