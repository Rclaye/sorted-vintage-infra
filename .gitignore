# --- Secrets: never commit ---
*.pem
*.key
id_rsa*
id_ed25519*
.env
.env.*
!.env.example
secrets.auto.tfvars
*.tfvars
*.tfvars.json
!*.tfvars.example
kubeconfig*
# The Kind provider writes the cluster kubeconfig, with its admin client key, next to the root it runs in.
terraform/**/*-config
*.sql
*.dump

# --- Terraform ---
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
# Modules take their provider versions from the roots; only the roots commit a lock file.
terraform/modules/**/.terraform.lock.hcl

# --- Python ---
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Java ---
target/
build/
.gradle/
*.class

# --- Local editor and assistant tooling ---
.claude/

# --- This machine's host and account names (scripts/lab/local.env.example) ---
scripts/lab/local.env

# --- Editors and OS ---
.DS_Store
.idea/
.vscode/
*.swp
*~
